{
  "proxy_group": "mem",
  "proxies": ["mem", "tmem"],
  "description": "Micro-erosion meter / traversing micro-erosion meter measurements of carbonate rock surface lowering.",

  "search": {
    "queries": [
      "\"micro-erosion meter\" limestone",
      "\"micro erosion meter\" limestone",
      "\"microerosion meter\" limestone",
      "\"traversing micro-erosion meter\"",
      "\"micro-erosion meter\" karst",
      "\"micro-erosion meter\" marble",
      "\"micro-erosion meter\" dolomite",
      "\"micro-erosion meter\" carbonate lowering rate",
      "limestone surface lowering rate karren measurement",
      "\"MEM\" limestone \"lowering rate\""
    ],
    "from_year": 1960,
    "seed_dois": [],
    "max_results_per_query": 400
  },

  "keyword_prefilter": {
    "comment": "A record passes if it hits >= 1 term from EVERY group in 'require_all_groups' and no term in 'exclude'. Matching is case-insensitive on title + abstract. Records with NO abstract always pass to the agent screen (flagged no_abstract).",
    "require_all_groups": [
      ["micro-erosion", "micro erosion", "microerosion", "mem ", "tmem", "erosion meter", "lowering rate", "surface lowering", "rock lowering"],
      ["limestone", "carbonate", "karst", "marble", "dolomite", "dolostone", "chalk", "calcareous", "aeolianite", "calcarenite", "karren"]
    ],
    "exclude": ["dental", "enamel", "tooth", "concrete pavement", "membrane", "memory"]
  },

  "screening_criteria": "config/screening_mem.md",
  "batch_size": 25
}
